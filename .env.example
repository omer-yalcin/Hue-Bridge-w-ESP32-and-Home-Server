# Hue Bridge identity
BRIDGE_NAME=HueBridge ESP
# Leave empty to auto-detect primary NIC MAC, or specify XX:XX:XX:XX:XX:XX
BRIDGE_MAC=
# Leave empty to auto-detect LAN IPv4 address
BIND_IP=

# Server ports (80/443 required for native Hue app compatibility)
HTTP_PORT=80
HTTPS_PORT=443
UI_PORT=3000

# Persistent state & TLS certificates directory
DATA_DIR=./data

# Multicast discovery (SSDP + mDNS _hue._tcp & _hue-esp-srv._tcp)
ENABLE_DISCOVERY=true

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

